{
  "expo": {
    "name": "Dispatch Mobile",
    "slug": "dispatch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dispatch",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "net.newleveltech.dispatch",
      "infoPlist": {
        "CFBundleDisplayName": "Dispatch"
      }
    },
    "android": {
      "package": "net.newleveltech.dispatch"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
