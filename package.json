{
  "name": "dispatch",
  "version": "1.0.0",
  "private": true,
  "description": "Dispatch management platform - monorepo",
  "scripts": {
    "check:deps": "node check-dep-drift.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "web:dev": "turbo run dev --filter=web",
    "mobile:dev": "turbo run dev --filter=mobile",
    "mobile:ios": "cd apps/mobile && pnpm ios",
    "mobile:android": "cd apps/mobile && pnpm android"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "turbo": "^2.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
